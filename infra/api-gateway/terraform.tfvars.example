# Copie para terraform.tfvars (git-ignored) e ajuste. Nao versione valores reais.
aws_region       = "sa-east-1"
stage_name       = "dev"
backend_base_url = "https://consultas.exemplo.interno"

consumers = {
  sistema-a = {
    rate_limit  = 50
    burst_limit = 100
  }
  sistema-b = {
    rate_limit  = 5
    burst_limit = 10
    quota = {
      limit  = 100000
      period = "DAY"
    }
  }
}
